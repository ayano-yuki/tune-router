# Python environments and caches
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Build and packaging artifacts
build/
dist/
*.egg-info/
*.egg

# uv
# Keep uv.lock tracked for reproducible runs.

# Environment variables and local machine settings
.env
.env.*
!.env.example
*.local

# Logs and temporary files
*.log
*.tmp
*.temp
tmp/
temp/

# TuneScope datasets
datasets/*/
!datasets/manifests/
!datasets/manifests/.gitkeep

# TuneScope experiment outputs
experiments/results/*
!experiments/results/.gitkeep
!experiments/manifests/
outputs/
checkpoints/
models/
adapters/

# Model and training artifacts that may be written outside result dirs
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
optimizer.pt
scheduler.pt
trainer_state.json
rng_state*.pth

# Experiment trackers and external tool caches
wandb/
mlruns/
.trackio/
.cache/
huggingface/

# Generated reports
reports/run-cards/
reports/*.html
reports/*.pdf
reports/*.json
reports/*.md
!reports/README.md

# OS and editor noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
